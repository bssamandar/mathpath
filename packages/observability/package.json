{
  "name": "@mathpath/observability",
  "version": "0.1.0",
  "private": true,
  "description": "JSON logs with personal data redacted, and Prometheus metrics, shared by the API and the worker.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "prom-client": "15.1.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.12",
    "vitest": "4.1.12",
    "yaml": "2.9.1"
  }
}
