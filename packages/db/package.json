{
  "name": "@mathpath/db",
  "version": "0.1.0",
  "private": true,
  "description": "Database access (Kysely), schema types and reversible migrations.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src",
