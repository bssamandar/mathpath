{
  "name": "@mathpath/client",
  "version": "0.1.0",
  "private": true,
  "description": "Browser client for the MathPath API, shared by the web app and the studio.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
