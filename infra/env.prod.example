# Production settings for infra/docker-compose.prod.yml.
#
# On the server:  cp infra/env.prod.example infra/.env.prod && chmod 600 infra/.env.prod
# then fill in every empty value. Never commit .env.prod.
#
# Generate each password and secret separately, as hex so it is safe inside
# URLs and JSON:   openssl rand -hex 32
# Business rules (prices, XP, limits) are not here: they live in config/*.yaml.

# ── Site ──────────────────────────────────────────────────
# The web app is served on DOMAIN, the studio on studio.DOMAIN and media on
# media.DOMAIN. All three DNS names must point at this server.
DOMAIN=
# Let's Encrypt sends certificate warnings here.
ACME_EMAIL=
LOG_LEVEL=info
# Requests per minute from one IP before the edge answers 429. Schools share
# one IP for a whole class, so keep it high.
EDGE_RATE_LIMIT_PER_MINUTE=3000
# 1 when only Caddy is in front of the API; 2 if the provider adds a load balancer.
TRUST_PROXY_HOPS=1

# ── Database ──────────────────────────────────────────────
# Superuser: maintenance only, never used by the apps.
POSTGRES_SUPERUSER_PASSWORD=
MATHPATH_MIGRATOR_PASSWORD=
MATHPATH_APP_PASSWORD=
# Also goes into infra/monitoring/secrets/postgres_monitoring_password.
MATHPATH_MONITORING_PASSWORD=
# About 25% and 75% of the server's RAM.
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=3GB
REDIS_MAXMEMORY=512mb

# ── Authentication (ADR-0005) ─────────────────────────────
# openssl genpkey -algorithm ed25519, on one line with \n between lines.
JWT_PRIVATE_KEY=
JWT_KEY_ID=
# Only while rotating the key: the previous public key and its ID.
JWT_PREVIOUS_PUBLIC_KEY=
JWT_PREVIOUS_KEY_ID=
AUTH_HMAC_SECRET=

# ── SMS (Eskiz.uz) and CAPTCHA (Cloudflare Turnstile) ─────
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_SENDER=4546
TURNSTILE_SECRET_KEY=
# The public site key is built into the web and studio images: set it as the
# repository variable TURNSTILE_SITE_KEY before tagging a release.

# ── Payments (ADR-0008) ───────────────────────────────────
# Comma-separated: payme, click. Empty keeps checkout closed.
PAYMENT_PROVIDERS=
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_CHECKOUT_URL=https://checkout.paycom.uz
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_CHECKOUT_URL=https://my.click.uz/services/pay

# ── Media storage (SeaweedFS in docker-compose.prod.yml) ──
S3_BUCKET=mathpath-media
# The API and worker: read and write objects in the bucket only.
S3_APP_ACCESS_KEY_ID=
S3_APP_SECRET_ACCESS_KEY=
# Bucket set-up and the media backup.
S3_ADMIN_ACCESS_KEY_ID=
S3_ADMIN_SECRET_ACCESS_KEY=
# Seals the HLS keys at rest. Losing it makes every transcoded video unplayable:
# keep a copy outside the server (docs/guides/backups.md).
MEDIA_KEY_SECRET=
# Parallel video encodes (1–8); each needs about one CPU core.
TRANSCODE_CONCURRENCY=1

# ── Off-site backups (pgBackRest and media sync) ──────────
# S3-compatible storage at a second provider or data centre in Uzbekistan,
# with versioning and object lock if offered (security plan C-50).
# Host name only, without https://, e.g. s3.example.uz
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# path or host, as the provider documents.
BACKUP_S3_URI_STYLE=path
# Encrypts every database backup. Losing it makes the backups useless:
# keep a copy outside the server (docs/guides/backups.md).
BACKUP_CIPHER_PASS=
# Full backups kept (one per night).
BACKUP_RETENTION_FULL=14
# AES256 if the provider supports server-side encryption for the media copy.
BACKUP_S3_SSE=
