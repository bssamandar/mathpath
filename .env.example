# Copy to .env for local development: `cp .env.example .env`.
# Every setting the apps read is listed here with a SAFE placeholder.
# Never put real secrets in this file or commit a .env file.
# Business rules (prices, XP, limits) are NOT here: they live in config/*.yaml.

# ── Common ────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
# Optional: where the business-rule YAML files are. Defaults to the repo's config/ folder.
# CONFIG_DIR=./config

# ── API (apps/api) ────────────────────────────────────────
PORT=4000
# Browser origins allowed to call the API with cookies (comma-separated).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
APP_VERSION=0.1.0-dev

# ── Added in later steps (not read yet) ───────────────────
# DATABASE_URL=postgres://mathpath:mathpath_local_only@localhost:5432/mathpath
# REDIS_URL=redis://localhost:6379
# JWT signing keys, SMS gateway, payment provider keys and S3 credentials are
# added with their modules; in production they come from the secret manager.
