# Copy to .env for local development: `cp .env.example .env`.
# Every setting the apps read is listed here with a SAFE placeholder.
# Never put real secrets in this file or commit a .env file.
# Business rules (prices, XP, limits) are NOT here: they live in config/*.yaml.

# ── Common ────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
# Optional: where the business-rule YAML files are. Defaults to the repo's config/ folder.
# CONFIG_DIR=./config

# ── API (apps/api) ────────────────────────────────────────
PORT=4000
# Browser origins allowed to call the API with cookies (comma-separated).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
APP_VERSION=0.1.0-dev
# Reverse proxies in front of the API (0 locally). Used to read the client IP.
TRUST_PROXY_HOPS=0

# ── Web (apps/web) ────────────────────────────────────────
# Where the Next.js server forwards /api. Defaults to http://localhost:4000 in
# development; in production the edge proxy routes /api to the API instead.
API_ORIGIN=
# Cloudflare Turnstile site key (public). Empty locally: the form offers the dev token.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Database (packages/db migrations and the API) ─────────
DATABASE_URL=postgres://mathpath:mathpath_local_only@localhost:5432/mathpath

# ── Authentication (apps/api, ADR-0005) ───────────────────
# Leave the keys empty locally: the API generates temporary ones at start-up
# (everyone is signed out on restart). Production refuses to start without them.
# Generate a signing key with:
#   openssl genpkey -algorithm ed25519
# and put it on one line with \n between lines.
JWT_PRIVATE_KEY=
JWT_KEY_ID=dev
# During key rotation only: the previous public key and its ID.
# JWT_PREVIOUS_PUBLIC_KEY=
# JWT_PREVIOUS_KEY_ID=
# At least 32 characters, for example: openssl rand -base64 48
AUTH_HMAC_SECRET=
# `log` prints SMS (with codes) to the API log. Development only.
# `eskiz` sends real SMS through Eskiz.uz (texts must be approved in the Eskiz dashboard).
SMS_PROVIDER=log
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_SENDER=4546

# ── Risk (apps/api, security plan §6) ─────────────────────
# `dev` accepts the CAPTCHA token "dev-pass"; production uses Cloudflare Turnstile.
CAPTCHA_PROVIDER=dev
TURNSTILE_SECRET_KEY=
# `hibp` checks new passwords against Have I Been Pwned (k-anonymity); `off` for offline work.
BREACHED_PASSWORD_CHECK=hibp

# ── Payments (apps/api, ADR-0008) ─────────────────────────
# Providers offered at checkout, comma-separated (payme, click). Empty closes checkout.
PAYMENT_PROVIDERS=
# Payme Merchant API: cashbox ID and key from the Payme business cabinet.
# Use the test key and checkout.test.paycom.uz until the cashbox is approved.
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_CHECKOUT_URL=https://checkout.test.paycom.uz
# Click Shop API: service ID, merchant ID and the service's secret key from the
# Click merchant cabinet. Set the Prepare and Complete URLs there to
# https://<api host>/api/v1/payments/click/prepare and .../complete.
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_CHECKOUT_URL=https://my.click.uz/services/pay

# Shared rate limits, revoked sessions and SMS budget. Leave empty to keep them
# in memory (one local instance only). Required in production.
REDIS_URL=redis://localhost:6379

# ── Media (apps/api and apps/worker, architecture §7.3) ───
# S3-compatible storage. Locally: `docker compose -f infra/docker-compose.yml up seaweedfs`.
# S3_ENDPOINT is what the API and worker use; S3_PUBLIC_ENDPOINT is the host
# browsers reach for presigned URLs (defaults to S3_ENDPOINT).
# Leave S3_ENDPOINT empty to keep media in memory (API only, development only).
S3_ENDPOINT=http://localhost:8333
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=mathpath-media
S3_ACCESS_KEY_ID=mathpath
S3_SECRET_ACCESS_KEY=mathpath_local_only
S3_FORCE_PATH_STYLE=true
# Seals each video's HLS key at rest. At least 32 characters; required in production.
MEDIA_KEY_SECRET=
# Browser origins (web, studio) allowed to PUT uploads to and GET segments from
# storage. Outside production the API writes this as the bucket's CORS rule;
# in production the bucket is provisioned with the same rule.
MEDIA_BROWSER_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Web and studio (apps/web, apps/studio) ──────────────
# Storage origin added to the CSP of web and studio (connect-src; web also
# media-src for segments and subtitles). Same host as S3_PUBLIC_ENDPOINT.
MEDIA_ORIGIN=http://localhost:8333

# ── Added in later steps (not read yet) ───────────────────
# Payment provider keys are added with their module; in production secrets
# come from the secret manager.
