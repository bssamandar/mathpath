{
  "name": "@mathpath/api",
  "version": "0.1.0",
  "private": true,
  "description": "MathPath HTTP API (NestJS modular monolith).",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --watch -r @swc-node/register src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@mathpath/config": "workspace:*",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "helmet": "8.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.8",
    "@swc-node/register": "1.10.10",
    "@swc/core": "1.13.21",
    "@types/express": "5.0.3",
    "@types/supertest": "6.0.3",
    "@vitest/coverage-v8": "4.1.12",
    "supertest": "7.1.4",
    "unplugin-swc": "1.6.0",
    "vitest": "4.1.12"
  }
}
