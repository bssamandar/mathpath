{
  "name": "@mathpath/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Background jobs: outbox relay, video transcoding, reports, renewals (BullMQ).",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@mathpath/config": "workspace:*",
    "@mathpath/db": "workspace:*",
    "@mathpath/media": "workspace:*",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "bullmq": "6.5.3",
    "kysely": "0.28.18",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@nestjs/testing": "11.2.8",
    "@swc/core": "1.13.21",
    "@vitest/coverage-v8": "4.1.12",
    "kysely-pglite-dialect": "1.4.0",
    "unplugin-swc": "1.6.0",
    "vitest": "4.1.12"
  }
}
