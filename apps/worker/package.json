{
  "name": "@mathpath/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Background jobs: outbox relay, video transcoding, reports, renewals (BullMQ).",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@mathpath/config": "workspace:*",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.8",
    "@swc/core": "1.13.21",
    "@vitest/coverage-v8": "3.2.4",
    "unplugin-swc": "1.5.7",
    "vitest": "3.2.4"
  }
}
